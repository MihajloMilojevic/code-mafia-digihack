# kopiraj u .env (docker-compose ga automatski cita) i izmeni po potrebi

# gde backend salje AimDK RPC - podrazumevano je "sim" servis unutar docker-a
# AIMDK_BASE_URL=http://sim:9000
# za pravi robot (pokretati NA PC2, ili sa masine koja vidi 192.168.100.100):
# AIMDK_BASE_URL=http://192.168.100.100:56322

# izvor kamere za hand-tracker - IP telefona (IP Webcam app na Androidu)
# HAND_TRACKER_SOURCE=http://192.168.1.50:8080/video
